cff-version: 1.2.0
title: "ProvenanceFaultTree: fault tree analysis with an evidence ledger"
message: "If you use this software, please cite both this work and the method it implements."
type: software
version: 0.1.0
doi: 10.5281/zenodo.23139763
authors:
  - family-names: Inderwildi
    given-names: Oliver
    orcid: "https://orcid.org/0000-0002-4315-7839"
license: MIT
repository-code: "https://github.com/oliverinderwildi/systems-analysis/tree/main/src/provenance-fault-tree"
abstract: >-
  An implementation of published fault tree analysis procedures in which no input may enter
  the model without a provenance record, every minimal cut set inherits the weakest evidence
  class among its inputs, and the authorship of each element of the tree - source document,
  human analyst, or language model - is recorded and reported alongside the result.
keywords:
  - fault tree analysis
  - minimal cut sets
  - reliability
  - evidence ledger
  - provenance
  - systems analysis
references:
  - type: report
    title: "Fault Tree Handbook"
    authors:
      - family-names: Vesely
        given-names: W. E.
      - family-names: Goldberg
        given-names: F. F.
      - family-names: Roberts
        given-names: N. H.
      - family-names: Haasl
        given-names: D. F.
    institution:
      name: "U.S. Nuclear Regulatory Commission"
    number: "NUREG-0492"
    year: 1981
  - type: software
    title: "SCRAM: Probabilistic Risk Analysis Tool"
    authors:
